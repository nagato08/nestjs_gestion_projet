// =========================================================
// CONFIGURATION GÉNÉRALE
// =========================================================

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// 2. UTILISATEURS & AUTHENTIFICATION
// =========================================================

enum Role {
  ADMIN
  PROJECT_MANAGER
  EMPLOYEE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Department {
  IT
  HR
  FINANCE
  MARKETING
  SALES
  OPERATIONS
  ADMINISTRATION
}

model User {
  id        String @id @default(cuid())
  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String @unique
  password  String

  avatar    String?
  jobTitle  String?
  role      Role   @default(EMPLOYEE)
  // 🏢 Département
  department Department
  
  // ✅ Soft delete
  deletedAt DateTime?

  // Sécurité
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  resetPasswordToken          String?   @unique
  resetPasswordTokenExpiresAt DateTime?
  isResetPasswordRequested Boolean @default(false)


  // Relations
  projectsOwned   Project[]        @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  taskAssignments TaskAssignment[]
  timeEntries     TimeEntry[]
  comments        Comment[]
  invitationsSent ProjectInvitation[] @relation("InvitationsSent")
  notifications   Notification[]
  documents       Document[]
  sentMessages    ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationSettings NotificationSettings[]

  documentComments DocumentComment[]

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]
}

// =========================================================
// 2.b SESSIONS / REFRESH TOKENS
// =========================================================

model RefreshToken {
  id        String @id @default(cuid())
  // Hash SHA-256 du refresh token (le token en clair n'est jamais stocké)
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  // Contexte de session (pour "déconnexion de tous les appareils")
  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// =========================================================
// 2.c JOURNAL D'AUDIT
// =========================================================

/// Trace immuable des actions sensibles : « qui a fait quoi, quand, sur quoi ».
/// Aucune relation vers la cible : l'entrée doit survivre à la suppression de
/// l'objet audité, sinon on perd justement la trace des suppressions.
model AuditLog {
  id String @id @default(cuid())

  /// Auteur de l'action. Null si le compte est supprimé par la suite : on
  /// conserve l'entrée (onDelete: SetNull) plutôt que d'effacer l'historique.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Dénormalisé : reste lisible même après suppression du compte.
  userEmail String?

  /// Verbe métier, ex. "project.delete", "member.role.update".
  action String

  /// Type et identifiant de l'objet visé, ex. "Project" / "clx123".
  targetType String?
  targetId   String?

  /// Contexte utile à l'enquête (ancien/nouveau rôle, nom du projet...).
  metadata Json?

  /// Origine de la requête.
  ip        String?
  userAgent String?

  /// Corrélation avec les logs applicatifs de la même requête.
  requestId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// =========================================================
// 3. PROJETS & MEMBRES
// =========================================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Project {
  id          String @id @default(cuid())
  name        String
  description String? @db.Text
  objectives  String? @db.Text
  priority    Priority
  status      ProjectStatus @default(PLANNING)

  startDate   DateTime
  endDate     DateTime?

  // Accès sécurisé
  projectCode String @unique
  inviteToken String @unique @default(cuid())

  // Chef de projet
  ownerId String
  owner   User @relation("ProjectOwner", fields: [ownerId], references: [id])

  // ✅ Soft delete
  deletedAt DateTime?

  // Relations
  members      ProjectMember[]
  tasks        Task[]
  documents    Document[]
  conversation Conversation?
  invitations  ProjectInvitation[]

  createdAt DateTime @default(now())
}

// Rôle d'un utilisateur DANS un projet donné (RBAC fin, indépendant du rôle global).
// Hiérarchie : OWNER > ADMIN > MEMBER > VIEWER.
enum ProjectRole {
  OWNER  // Propriétaire : tout, y compris supprimer le projet et transférer la propriété
  ADMIN  // Co-gestionnaire : membres, paramètres, tâches, documents
  MEMBER // Contributeur : tâches, documents, chat
  VIEWER // Lecture seule
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String

  role ProjectRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Invitation nominative à rejoindre un projet.
///
/// Distincte du `inviteToken` du projet, qui est un lien partagé valable pour
/// tout le monde : ici chaque token est lié à UNE adresse email, expire, et
/// se révoque individuellement sans impacter les autres invitations.
model ProjectInvitation {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Destinataire. Stocké en minuscules pour une comparaison fiable.
  email String

  /// Rôle attribué automatiquement à l'acceptation.
  role ProjectRole @default(MEMBER)

  /// Hash SHA-256 du token ; le token en clair ne vit que dans l'email.
  tokenHash String @unique

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  /// Auteur de l'invitation. Conservé même si le compte disparaît.
  invitedById String?
  invitedBy   User?   @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  acceptedAt     DateTime?
  acceptedUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([email])
  @@index([status])
}

// =========================================================
// 4. TÂCHES, SOUS-TÂCHES & DÉPENDANCES
// =========================================================

enum TaskStatus {
  TODO
  DOING
  DONE
}

model Task {
  id          String @id @default(cuid())
  title       String
  description String? @db.Text
  priority    Priority
  status      TaskStatus @default(TODO)
  deadline    DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Gantt : dates de début/fin pour la barre horizontale (drag & drop)
  startDate DateTime?
  endDate   DateTime?

  // PERT : estimations pour te = (o + 4m + p) / 6 (en jours)
  optimisticDays  Int?
  probableDays    Int?
  pessimisticDays Int?

  // Burndown / vélocité : points de story (optionnel)
  storyPoints Int?

  // Sous-tâches
  parentId String?
  parent   Task?  @relation("SubTasks", fields: [parentId], references: [id])
  subTasks Task[] @relation("SubTasks")

  // Dépendances
  dependencies TaskDependency[] @relation("BlockingTask")
  blockedBy    TaskDependency[] @relation("BlockedTask")

  assignments TaskAssignment[]
  comments    Comment[]
  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskDependency {
  id             String @id @default(cuid())
  blockingTaskId String
  blockedTaskId  String

  blockingTask Task @relation("BlockingTask", fields: [blockingTaskId], references: [id])
  blockedTask  Task @relation("BlockedTask", fields: [blockedTaskId], references: [id])
}

model TaskAssignment {
  id     String @id @default(cuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// =========================================================
// 5. DOCUMENTS & VERSIONS
// =========================================================

model Document {
  id        String @id @default(cuid())
  name      String
  projectId String
  uploadedBy String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [uploadedBy], references: [id])

  versions  DocumentVersion[]
  comments  DocumentComment[]

  createdAt DateTime @default(now())
}

model DocumentVersion {
  id         String @id @default(cuid())
  version    Int
  fileUrl    String
  fileSize   Int?
  documentId String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model DocumentComment {
  id         String @id @default(cuid())
  content    String @db.Text
  documentId String
  userId     String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// =========================================================
// 6. COMMUNICATION & NOTIFICATIONS
// =========================================================

model Comment {
  id        String @id @default(cuid())
  content   String @db.Text
  taskId    String
  userId    String
  mentions  String[]

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id      String @id @default(cuid())
  type    String
  content String
  isRead  Boolean @default(false)
  userId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// =========================================================
// 7. SUIVI DU TEMPS
// =========================================================

model TimeEntry {
  id        String @id @default(cuid())
  taskId   String
  userId   String

  startTime DateTime @default(now())
  endTime   DateTime?
  duration  Int?
  isManual  Boolean @default(false)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// =========================================================
// 8. PARAMÈTRES & CONFIGURATION
// =========================================================

model CompanySettings {
  id           String @id @default("global")
  companyName  String?
  logoUrl      String?
  primaryColor String?
}

model NotificationSettings {
  id        String @id @default(cuid())
  userId    String @unique
  email     Boolean @default(true)
  realtime  Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

// =========================================================
// 9. CHAT TEMPS RÉEL (CONVERSATIONS)
// =========================================================

model Conversation {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id             String @id @default(cuid())
  content        String
  senderId       String
  conversationId String

  /// Identifiants des utilisateurs mentionnés (@) dans le message.
  mentions String[]

  sender       User         @relation(fields: [senderId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  attachments ChatAttachment[]

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
}

/// Fichier joint à un message de chat.
///
/// Remplace l'encodage `[attachment:nom:url:taille:type]` qui était glissé
/// dans le texte du message : un contenu comportant cette séquence cassait
/// l'affichage, et les métadonnées n'étaient ni typées ni interrogeables.
model ChatAttachment {
  id String @id @default(cuid())

  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// Nom d'origine du fichier, tel que déposé par l'utilisateur.
  name String
  /// URL publique (Cloudinary).
  url String
  /// Taille en octets.
  size Int
  /// Type MIME, ex. `image/png`.
  mimeType String

  createdAt DateTime @default(now())

  @@index([messageId])
}
